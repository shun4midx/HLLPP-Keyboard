<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.HLLPPKeyboard" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/custom_hllpp_logo_blue</item>
        <item name="colorPrimaryVariant">@color/custom_hllpp_banner_blue</item>
        <item name="colorOnPrimary">@color/custom_hllpp_logo_purple</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/custom_hllpp_banner_pink</item>
        <item name="colorSecondaryVariant">@color/custom_hllpp_banner_pink</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <item name="android:actionBarStyle">@style/HLLPP.ActionBar</item>
        <item name="actionBarStyle">@style/HLLPP.ActionBar</item>
    </style>

    <style name="HLLPP.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/custom_hllpp_banner_blue</item>
        <item name="titleTextStyle">@style/HLLPP.ActionBar.TitleText</item>
    </style>

    <style name="HLLPP.ActionBar.TitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/custom_hllpp_logo_purple</item>
    </style>

